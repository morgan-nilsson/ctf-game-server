[Unit]
Description=CTF referee tick loop (control plane)
Documentation=file:/opt/ctf/RULES.md
After=network-online.target ctf-topology.service
Requires=ctf-topology.service

[Service]
Type=exec
Environment=CTF_CONFIG=/etc/ctf/ctf.toml
WorkingDirectory=/opt/ctf
ExecStart=/usr/bin/python3 -m orchestrator.tick
Restart=always
RestartSec=5
User=ctf
Group=ctf
# The referee reads and writes the flag store; nothing else should.
StateDirectory=ctf
ReadWritePaths=/srv/ctf
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# --- hardening: this process parses hostile input ------------------------
# The prober is the one channel that must stay open into a player-controlled
# service, so treat it as attack surface rather than trusted infrastructure.
UMask=0077
MemoryMax=512M
MemorySwapMax=0
TasksMax=128
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
